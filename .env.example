# ── Backroom Arcade ──────────────────────────────────────────────────────────
# Secret for session cookies. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Password for the admin account created on first boot. Change it after login.
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Port the arcade web server listens on
PORT=3000

# (Docker) Paths for DB and uploads
# DB_PATH=/data/db/data.sqlite
# UPLOAD_DIR=/data/uploads/games

# ── Eaglercraft Server (Docker only) ────────────────────────────────────────
# Port the Eaglercraft WebSocket gateway and browser client runs on
EAGLER_WS_PORT=8081

# Port for the raw Minecraft TCP socket (Java LAN clients, optional)
EAGLER_MC_PORT=25565

# Paper server version: 1.12.2 (recommended) or 1.8.8
MINECRAFT_VERSION=1.12.2

# JVM heap size for the Paper server (e.g. 1G, 2G, 4G)
EAGLER_MEMORY=2G
